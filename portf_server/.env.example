# Application
NODE_ENV=development
PORT=3000
HOST=localhost
APP_URL=http://localhost:3000

# Data persistence
APP_DATA_PATH=./data/

# Auth (defaults exist in code; override for production)
JWT_SECRET=changeMeInProd
JWT_EXPIRES_IN=1d
COOKIE_MAX_AGE=86400000
BCRYPT_ROUNDS=12

# Rate limiting
API_LIMIT=1000
API_COOLDOWN=300000
